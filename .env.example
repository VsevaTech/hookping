# Telegram bot token from @BotFather. Required for Telegram delivery.
# Leave empty to run HookPing without Telegram (events are still stored).
TELEGRAM_BOT_TOKEN=

# Bot username without "@" — used to build the "Connect Telegram" deep link.
HOOKPING_TELEGRAM_BOT_USERNAME=hook_ping_bot

# Public URL of this HookPing instance, used to display webhook URLs.
# Leave empty to derive it from the incoming request (Host / X-Forwarded-* headers).
PUBLIC_BASE_URL=

# Where SQLite lives. The Docker image defaults to /data/hookping.db (a named volume).
# HOOKPING_DATABASE_URL=sqlite:////data/hookping.db

# Maximum accepted webhook body in bytes (default 256 KB).
# HOOKPING_MAX_BODY_BYTES=262144

# How many events to keep per inbox (older ones are pruned).
# HOOKPING_MAX_EVENTS_PER_INBOX=200

# Set to false to run several HookPing instances against one bot (only one may poll).
# HOOKPING_TELEGRAM_POLLING=true

# LOG level: DEBUG, INFO, WARNING
# HOOKPING_LOG_LEVEL=INFO
